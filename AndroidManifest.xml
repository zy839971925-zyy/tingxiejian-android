<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.tingxiejian" android:versionCode="100" android:versionName="1.0">
    <!-- Only for the optional cloud AI / cloud ASR features. Nothing leaves the phone unless
         the user fills in an API key in Settings; all network code lives in Cloud.java. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Optional Shizuku Binder bridge: the transcription pipeline never needs it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>
    <!-- Short haptic ticks on start / finish / error / copy, paired with the motion. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Android 11+ package visibility: the reference's XMSF UID probe cannot work without this. -->
    <queries><package android:name="com.xiaomi.xmsf"/><package android:name="moe.shizuku.privileged.api"/></queries>
    <application android:name=".TingxiejianApp" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:extractNativeLibs="true" android:allowBackup="false" android:debuggable="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".WelcomeActivity" android:exported="false" android:screenOrientation="unspecified"/>
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="unspecified"/>
        <activity android:name=".TranscriptActivity" android:exported="false" android:screenOrientation="unspecified"/>
        <activity android:name=".ChatActivity" android:exported="false" android:screenOrientation="unspecified"/>
        <service android:name=".LocalService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true"/>
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.example.tingxiejian.shizuku"
            android:exported="true" android:enabled="true" android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        <!--
          Documented markers for 小米超级岛. This build is debug-signed and is not registered on
          小米开放平台, so it has no com.xiaomi.xms.APP_ID. Even a valid payload may be filtered by
          SystemUI's private eligibility rules; the flag below is debug metadata, NOT a whitelist.
        -->
        <meta-data android:name="com.xiaomi.xms.BUILD_TYPE_DEBUG" android:value="true"/>
    </application>
</manifest>
