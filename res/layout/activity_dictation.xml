<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <View android:id="@+id/portal_surface" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/bg_portal" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/portal_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="20dp" android:transitionGroup="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:src="@drawable/ic_back" android:tint="@color/ink"
                android:background="@drawable/bg_icon_circle" android:contentDescription="返回并结束听写"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                style="@style/T.CardTitle" android:text="实时听写" android:gravity="center"/>
            <TextView android:id="@+id/dictation_timer" android:layout_width="wrap_content" android:minWidth="64dp" android:layout_height="wrap_content"
                style="@style/T.Caption" android:text="00:00" android:gravity="end"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="8dp">
        <TextView android:id="@+id/dictation_orb" android:layout_width="88dp" android:layout_height="88dp"
            android:layout_gravity="center" android:layout_marginTop="16dp" android:background="@drawable/bg_circle_soft"
            android:gravity="center" android:text="听" android:textSize="30sp" android:textColor="@color/accent"
            android:importantForAccessibility="no"/>
        <TextView android:id="@+id/dictation_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" style="@style/T.CardTitle" android:gravity="center" android:text="准备好，就开始说话"/>
        <TextView android:id="@+id/dictation_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/T.Caption" android:gravity="center" android:layout_marginTop="8dp"
            android:text="仅在本页面前台录音；离开会结束并保存。"/>
        <com.example.tingxiejian.WaveView android:id="@+id/dictation_wave" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="12dp" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="12dp">
            <TextView android:id="@+id/dictation_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/T.Body" android:text="即时文字会出现在这里" android:minHeight="168dp" android:textIsSelectable="true"
                android:accessibilityLiveRegion="none"/>
        </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <TextView android:id="@+id/dictation_pause" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:layout_weight="1" style="@style/T.Body" android:gravity="center" android:text="暂停" android:textColor="@color/action_text"
                android:background="@drawable/bg_circle_soft" android:enabled="false"/>
            <TextView android:id="@+id/dictation_start_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:layout_weight="1" android:layout_marginStart="12dp" style="@style/T.Body" android:gravity="center"
                android:text="开始听写" android:textColor="@color/on_accent" android:background="@drawable/bg_round_primary"/>
        </LinearLayout>
        <TextView android:id="@+id/dictation_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            style="@style/T.Body" android:gravity="center" android:text="查看忠实稿 / 整理稿" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
