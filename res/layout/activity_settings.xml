<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Only this empty surface morphs from the opening control; content fades in later. -->
    <View
        android:id="@+id/portal_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_portal"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/portal_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:transitionGroup="true">

    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/back"
            android:background="@drawable/bg_icon_circle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ink"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/T.Title"
            android:text="设置" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/guide_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawableTint="@color/accent"
                style="@style/T.Label"
                android:text="首次使用与权限指南" />

            <!-- 识别 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                style="@style/T.CardTitle"
                android:drawableStart="@drawable/ic_person"
                android:drawableTint="@color/accent"
                android:drawablePadding="8dp"
                android:text="识别" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/T.Label"
                    android:text="区分发言人" />

                <Switch
                    android:id="@+id/diarize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Label"
                    android:text="说话人数" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/speaker_seg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 外观 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                style="@style/T.CardTitle"
                android:drawableStart="@drawable/ic_sun"
                android:drawableTint="@color/accent"
                android:text="外观" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:padding="14dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/appearance_seg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/T.Label"
                        android:text="减少动效" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/T.Caption"
                        android:layout_marginTop="4dp"
                        android:text="关闭页面转场与装饰动画；系统关闭动画时也会自动遵从。" />
                </LinearLayout>
                <Switch
                    android:id="@+id/reduce_motion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="减少动效" />
            </LinearLayout>

            <TextView android:id="@+id/motion_rhythm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:padding="12dp"
                android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
                android:background="@drawable/bg_row" style="@style/T.Label"/>
            <Switch android:id="@+id/haptic_feedback" android:layout_width="match_parent" android:layout_height="52dp"
                android:text="触觉反馈" android:contentDescription="触觉反馈，与减少动效独立"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" style="@style/T.CardTitle" android:id="@+id/realtime_title" android:text="实时进度与系统状态"/>
            <Switch android:id="@+id/live_updates" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:text="标准 Android 实时进度" android:contentDescription="标准 Android 实时进度，与小米超级岛开关独立"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/T.Caption"
                android:text="Android 16+ 可请求实时活动，由系统决定是否呈现。ColorOS 16 可采用标准展示；旧系统保留普通通知。小米与 Shizuku 的开关仅控制原超级岛链路。"/>
            <TextView android:id="@+id/realtime_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textIsSelectable="true" style="@style/T.Caption"/>
            <TextView android:id="@+id/promotion_settings" android:layout_width="match_parent" android:layout_height="52dp"
                android:gravity="center_vertical" android:background="@drawable/bg_row" android:padding="14dp"
                style="@style/T.Label" android:text="系统实时活动与通知设置"/>

            <!-- Xiaomi-only controls: never expose Shizuku as a global requirement. -->
            <LinearLayout android:id="@+id/xiaomi_island_section"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <!-- 超级岛 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                style="@style/T.CardTitle"
                android:drawableStart="@drawable/ic_wave"
                android:drawableTint="@color/accent"
                android:text="超级岛" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:id="@+id/island_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    style="@style/T.Label"
                    android:text="转写时尝试在超级岛显示进度" />

                <Switch
                    android:id="@+id/island_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/T.Label"
                    android:text="可选 · 用 Shizuku 尝试小米门禁" />
                <Switch
                    android:id="@+id/shizuku_island_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="允许短时限制 XMSF 网络以尝试显示超级岛" />
            </LinearLayout>

            <TextView
                android:id="@+id/shizuku_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/T.Caption"
                android:text="不影响离线转写；启用后会短暂更改系统网络规则，可能影响同期推送或网络连接。重启后需重新启动 Shizuku。" />

            <TextView
                android:id="@+id/shizuku_authorize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_seg_off"
                android:gravity="center"
                android:text="启动／授权 Shizuku"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/island_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/T.Caption"
                android:text="" />

            <TextView
                android:id="@+id/island_test"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_seg_off"
                android:gravity="center"
                android:text="测试系统超级岛 · 12 秒"
                android:textColor="@color/ink"
                android:contentDescription="发布 12 秒超级岛测试通知，不上传录音" />

            <TextView
                android:id="@+id/island_permission_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_row"
                android:gravity="center"
                android:text="检查系统通知与焦点权限"
                android:textColor="@color/accent" />

            </LinearLayout>

            <!-- 模型 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                style="@style/T.CardTitle"
                android:drawableStart="@drawable/ic_refresh"
                android:drawableTint="@color/accent"
                android:text="离线模型" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/model_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/T.Meta"
                    android:text="" />

                <TextView
                    android:id="@+id/model_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_pill"
                    android:paddingLeft="16dp"
                    android:paddingTop="10dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="10dp"
                    style="@style/T.Meta"
                    android:text="重新准备" />
            </LinearLayout>

            <!-- 云端 AI（可选） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="2dp"
                style="@style/T.CardTitle"
                android:drawableStart="@drawable/ic_cloud"
                android:drawableTint="@color/accent"
                android:text="云端 AI（可选）" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/T.Caption"
                android:text="保存 API Key 后，转写过程中会自动把文字分段发送到你配置的接口轻度校正；忠实稿保留。不开云端识别不会发送音频。无 Key 则跳过校正并提示。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:orientation="vertical"
                android:padding="14dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/cloud_provider_seg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/T.Caption"
                    android:text="API Key" />

                <EditText
                    android:id="@+id/cloud_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    style="@style/T.Label"
                    android:hint="sk-…" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/T.Caption"
                    android:text="接口地址（OpenAI 兼容 base URL）" />

                <EditText
                    android:id="@+id/cloud_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:inputType="textUri"
                    android:padding="12dp"
                    style="@style/T.Label"
                    android:hint="https://api.xiaomimimo.com/v1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/T.Caption"
                    android:text="对话模型（总结 / 提问 / 整理）" />

                <EditText
                    android:id="@+id/cloud_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:inputType="text"
                    android:padding="12dp"
                    style="@style/T.Label"
                    android:hint="mimo-v2.5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/T.Label"
                        android:text="转写时用云端识别" />

                    <Switch
                        android:id="@+id/cloud_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/T.Caption"
                    android:text="云端识别模型（可留空 = 只用本地）" />

                <EditText
                    android:id="@+id/cloud_asr_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:inputType="text"
                    android:padding="12dp"
                    style="@style/T.Label"
                    android:hint="mimo-v2.5-asr" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cloud_test"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:background="@drawable/bg_row"
                        android:gravity="center"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        style="@style/T.Label"
                        android:text="测试连接" />

                    <TextView
                        android:id="@+id/cloud_clear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_row"
                        android:gravity="center"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        style="@style/T.Label"
                        android:text="清空配置" />
                </LinearLayout>

                <TextView
                    android:id="@+id/cloud_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/T.Caption"
                    android:text="" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                style="@style/T.CardTitle" android:text="本地高精度识别"/>
            <TextView android:id="@+id/local_model_choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                style="@style/T.Body" android:background="@drawable/bg_row" android:padding="14dp"
                android:drawableEnd="@drawable/ic_chevron" android:drawableTint="@color/accent"
                android:drawablePadding="12dp" android:text="选择本地复核模型"/>
            <TextView android:id="@+id/qwen_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" style="@style/T.Caption" android:textIsSelectable="true"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/T.Caption"
                android:text="先显示即时稿，再逐段高精度复核。Qwen3 约 941 MiB，加载需要至少 3 GiB 可用系统内存；不足时自动回退标准复核。"/>
            <TextView android:id="@+id/prepare_qwen" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:layout_marginTop="12dp" android:padding="14dp"
                style="@style/T.Label" android:text="准备内置 Qwen3 模型" android:gravity="center"
                android:textColor="@color/on_accent" android:background="@drawable/bg_primary"/>
            <TextView android:id="@+id/import_qwen" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:layout_marginTop="8dp" android:padding="14dp"
                style="@style/T.Label" android:text="从目录导入模型（可选）" android:gravity="center" android:background="@drawable/bg_row"/>
            <EditText android:id="@+id/user_hotwords" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="80dp" android:inputType="textMultiLine" android:maxLength="8192" android:hint="热词：每行一个，例如人名、专业词"
                android:textSize="16sp" android:textColor="@color/ink" android:background="@drawable/bg_input" android:padding="12dp"/>

            <!-- 关于 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                style="@style/T.CardTitle"
                android:drawableStart="@drawable/ic_shield"
                android:drawableTint="@color/accent"
                android:text="关于" />

            <TextView
                android:id="@+id/version_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/T.Caption"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/T.Caption"
                android:text="默认转写、分人与标点在本机完成。启用并配置云端识别后，所选音频才会发送至配置的服务。" />

            <TextView
                android:id="@+id/diagnostics_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="查看本机诊断（不自动分享）"
                style="@style/T.Label" />

            <TextView
                android:id="@+id/clear_audio_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="清除临时音频（会停止结果试听）"
                style="@style/T.Label" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>
