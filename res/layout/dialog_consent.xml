<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="听写间  /  使用条款"
        android:textAllCaps="false"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="第三方组件\n阅读并确认。"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        style="@style/T.Sub"
        android:text="模型与运行库保留各自许可，本应用不授予其中任何再分发权。确认后即可开始离线转写。" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/bg_row"
        android:scrollbars="none">

        <TextView
            android:id="@+id/consent_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            style="@style/T.Body"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/consent_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:text="@string/consent_checkbox" />
    </LinearLayout>

    <TextView
        android:id="@+id/consent_accept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@drawable/bg_primary"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="@color/on_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/consent_accept" />

    <TextView
        android:id="@+id/consent_decline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:text="@string/consent_decline" />
</LinearLayout>
